<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EventContracts</PackageId>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>EventContracts contributors</Authors>
    <Description>Transport-independent integration-event envelopes and strongly typed metadata contracts.</Description>
    <PackageTags>events;contracts;integration-events</PackageTags>
